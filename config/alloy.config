// =============================================================================
// Grafana Alloy — ships logs to Loki.
//   1. every Docker container on this host (label: container=<name>)
//   2. host Nginx access and error logs (label: job=nginx)
// =============================================================================

// ---- Docker containers ----
discovery.docker "all" {
  host = "unix:///var/run/docker.sock"
}

// Turn "/hermes" into container="hermes" and keep the compose service name.
discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.all.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

// ---- Host Nginx logs ----
local.file_match "nginx" {
  path_targets = [
    {"__path__" = "/host/var/log/nginx/access.log", "job" = "nginx", "stream" = "access"},
    {"__path__" = "/host/var/log/nginx/error.log",  "job" = "nginx", "stream" = "error"},
  ]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.local.receiver]
}

// ---- Destination ----
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
