# =============================================================================
# Image versions used by compose.yml
#
# The installer copies any key missing from /opt/sakir-ai/.env into it, so
# `docker compose` picks these up automatically. To upgrade one service:
#   1. change its tag in /opt/sakir-ai/.env
#   2. sakir-ai update
#
# Pinned majors are known-good. "latest" tags are for fast-moving projects;
# after the first successful install, run `sakir-ai versions` and pin the
# exact versions it prints into /opt/sakir-ai/.env so updates are deliberate.
# =============================================================================
HERMES_IMAGE=nousresearch/hermes-agent:latest
N8N_IMAGE=n8nio/n8n:latest
POSTGRES_IMAGE=postgres:16-alpine
QDRANT_IMAGE=qdrant/qdrant:latest
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:1
LOKI_IMAGE=grafana/loki:3.4.2
ALLOY_IMAGE=grafana/alloy:latest
GRAFANA_IMAGE=grafana/grafana:latest
